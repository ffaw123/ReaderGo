# 运行环境标识，可供后续日志与错误策略区分使用。
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://readergo:readergo@localhost:5432/readergo?sslmode=disable&timezone=Asia/Shanghai
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://readergo:readergo-secret@localhost:5672/readergo
RABBITMQ_JOBS_EXCHANGE=readergo.video.jobs
RABBITMQ_DLX_EXCHANGE=readergo.video.dlx
RABBITMQ_PREFETCH=1
# 必须大于最长单阶段处理时间；当前 21600000 ms 为 6 小时。
RABBITMQ_CONSUMER_TIMEOUT_MS=21600000
JOB_MAX_ATTEMPTS=4
JOB_RETRY_DELAYS=30s,5m,30m
JOB_LEASE_TTL=2m
JOB_HEARTBEAT_INTERVAL=30s
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=readergo
MINIO_SECRET_KEY=readergo
MINIO_BUCKET=videos
MINIO_SECURE=false
# FFmpeg 和 ffprobe 须安装在同一目录；Windows 路径使用正斜杠可避免转义问题。
FFMPEG_PATH=E:/MyApps/ffmpeg/bin/ffmpeg.exe
# OpenAI 兼容 ASR 接口。切换供应商时修改以下配置即可。
ASR_API_KEY=replace-with-your-api-key
ASR_BASE_URL=https://api.xiaomimimo.com/v1
ASR_MODEL=mimo-v2.5-asr
# 同一视频最多同时进行 10 路音频提取、静音检测和转写。
ASR_CONCURRENCY=10
# Qwen-VL-OCR 使用百炼 OpenAI 兼容接口；API Key 和 Workspace ID 均与地域绑定。
OCR_API_KEY=replace-with-your-api-key
OCR_BASE_URL=replace-with-your-base_url
OCR_MODEL=qwen-vl-ocr
OCR_SCENE_THRESHOLD=0.3
# 相邻抽样帧的 64 位差值哈希距离不大于该值时视为重复画面。
OCR_HASH_DISTANCE=5
# 同一视频最多并发 10 个 OCR 模型请求。
OCR_CONCURRENCY=10
# RAG 文本生成与 Embedding 使用同一套 OpenAI 兼容服务；请替换为真实凭据与可用模型。
RAG_API_KEY=replace-with-your-api-key
RAG_BASE_URL=replace-with-your-base_url
RAG_CHAT_MODEL=qwen3.7-flash
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
# 每个 60 秒窗口独立请求，最多同时执行 10 个结构化生成请求。
RAG_CONCURRENCY=10
RAG_REQUEST_TIMEOUT=2m
UPLOAD_PART_SIZE_MIB=32
UPLOAD_URL_TTL_MINUTES=15
# 生产环境必须替换为至少 32 字符的高熵私密值；修改后已有 Token 会失效。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_TTL_HOURS=24
