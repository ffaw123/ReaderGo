# 运行环境标识，可供后续日志与错误策略区分使用。
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://readergo:readergo@localhost:5432/readergo?sslmode=disable&timezone=Asia/Shanghai
REDIS_ADDR=localhost:6379
RABBITMQ_URL=amqp://readergo:readergo-secret@localhost:5672/readergo
RABBITMQ_JOBS_EXCHANGE=readergo.video.jobs
RABBITMQ_DLX_EXCHANGE=readergo.video.dlx
RABBITMQ_PREFETCH=1
# 必须大于最长单阶段处理时间；当前 21600000 ms 为 6 小时。
RABBITMQ_CONSUMER_TIMEOUT_MS=21600000
JOB_MAX_ATTEMPTS=4
JOB_RETRY_DELAYS=30s,5m,30m
JOB_LEASE_TTL=2m
JOB_HEARTBEAT_INTERVAL=30s
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=readergo
MINIO_SECRET_KEY=readergo
MINIO_BUCKET=videos
MINIO_SECURE=false
# FFmpeg 和 ffprobe 须安装在同一目录；Windows 路径使用正斜杠可避免转义问题。
FFMPEG_PATH=E:/MyApps/ffmpeg/bin/ffmpeg.exe
# OpenAI 兼容 ASR 接口。切换供应商时修改以下配置即可。
ASR_API_KEY=replace-with-your-api-key
ASR_BASE_URL=https://api.xiaomimimo.com/v1
ASR_MODEL=mimo-v2.5-asr
# 同一视频最多同时进行 3 转写。
ASR_CONCURRENCY=3
# Qwen-VL-OCR 使用百炼 OpenAI 兼容接口；API Key 和 Workspace ID 均与地域绑定。
OCR_API_KEY=replace-with-your-api-key
OCR_BASE_URL=replace-with-your-base_url
OCR_MODEL=qwen-vl-ocr
OCR_SCENE_THRESHOLD=0.3
# 相邻抽样帧的 64 位差值哈希距离不大于该值时视为重复画面。
OCR_HASH_DISTANCE=5
# 同一视频最多并发 5 个 OCR 模型请求。
OCR_CONCURRENCY=5
# RAG 分段、章节摘要与 Embedding 使用同一套 OpenAI 兼容服务；请替换为真实凭据与可用模型。
RAG_API_KEY=replace-with-your-api-key
RAG_BASE_URL=replace-with-your-base_url
RAG_CHAT_MODEL=qwen3.7-flash
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
# rag_index 每个 60 秒窗口独立请求，最多同时执行 10 个结构化生成请求。
RAG_CONCURRENCY=10
RAG_REQUEST_TIMEOUT=2m
# 面向用户的回答模型使用独立凭据，不复用后台 RAG 或意图识别服务。
CHAT_API_KEY=replace-with-your-chat-api-key
CHAT_BASE_URL=replace-with-your-chat-base-url
CHAT_MODEL=replace-with-your-chat-model
CHAT_REQUEST_TIMEOUT=1m
CHAT_MAX_INPUT_RUNES=4000
CHAT_HISTORY_TURNS=3
# 向量召回最低余弦相似度；上线前应使用真实问答集校准。
CHAT_RAG_MIN_SIMILARITY=0.25
# 意图识别模型为服务端内部配置，不通过前端向用户开放，后续可替换为本地兼容服务。
INTENT_API_KEY=replace-with-your-intent-api-key
INTENT_BASE_URL=replace-with-your-intent-base-url
INTENT_MODEL=replace-with-your-intent-model
INTENT_REQUEST_TIMEOUT=20s
INTENT_CONFIDENCE_THRESHOLD=0.75
UPLOAD_PART_SIZE_MIB=32
UPLOAD_URL_TTL_MINUTES=15
# URL 视频下载使用流式临时文件；每次重定向都会重新校验目标地址。
PREPARE_MAX_FILE_SIZE_MIB=2048
PREPARE_CONNECT_TIMEOUT=10s
PREPARE_RESPONSE_HEADER_TIMEOUT=30s
PREPARE_DOWNLOAD_TIMEOUT=2h
PREPARE_MAX_REDIRECTS=5
# Worker 启动时会校验 yt-dlp，处理外部 URL 时请使用 2026.07.04 或更新版本。
YT_DLP_PATH=E:/MyApps/ytdlp/yt-dlp.exe
YT_DLP_MAX_HEIGHT=1080
PREPARE_MAX_DURATION=6h
# 生产环境必须替换为至少 32 字符的高熵私密值；修改后已有 Token 会失效。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_TTL_HOURS=24
# 离线检索评测仅由 go test 读取；保持为 0 可避免日常测试产生真实 Embedding 调用。
RUN_RETRIEVAL_EVAL=0
RETRIEVAL_EVAL_DATABASE_URL=postgres://readergo:readergo@localhost:5433/readergo_eval?sslmode=disable&timezone=Asia/Shanghai
RETRIEVAL_EVAL_DATASET=docs/evaldata/retrieval_tuning_questions.jsonl
RETRIEVAL_EVAL_DATABASE_SNAPSHOT=docs/evaldata/retrieval_tuning_database.sql
RETRIEVAL_EVAL_RESULTS=docs/evaldata/retrieval_eval_runs.jsonl
