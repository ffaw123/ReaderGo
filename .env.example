# 运行环境标识，可供后续日志与错误策略区分使用。
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://readergo:readergo@localhost:5432/readergo?sslmode=disable&timezone=Asia/Shanghai
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=readergo
MINIO_SECRET_KEY=readergo-secret
MINIO_BUCKET=videos
MINIO_SECURE=false
UPLOAD_PART_SIZE_MIB=32
UPLOAD_URL_TTL_MINUTES=15
# 生产环境必须替换为至少 32 字符的高熵私密值；修改后已有 Token 会失效。
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_TTL_HOURS=24
